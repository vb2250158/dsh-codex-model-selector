{
  "name": "dsh-codex-model-selector",
  "version": "0.1.1",
  "type": "module",
  "description": "Compact Codex-style model and reasoning selector for DSH",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "upstreamRepository": "deepseek-ai/deepseek-harness"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lightningcss": "^1.30.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@testing-library/react": "^16.3.0",
    "vitest": "^4.1.0",
    "jsdom": "^26.1.0"
  },
  "author": "vb2250158",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-codex-model-selector.git"
  },
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-codex-model-selector/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
